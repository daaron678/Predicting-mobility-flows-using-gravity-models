library(sf)
fl_tessellation <- st_read("../data/fl_tessellation.shp",
geometry_column = "geometry",
fid_column_name = "fid", crs = "EPSG: 4269")
num_tracts <- dim(fl_tessellation)[1]
M <- matrix(NA, nrow = num_tracts, ncol = num_tracts)
attach(fl_tessellation)
length(unique(fid)) == nrow(fl_tessellation)   # all fids are unique
# we must name dimensions
dimnames(mobility_matrices$M)
dimnames(M) <- list(origin = fid, destination = fid)
# now fill in M with values from 'flows'
# class(rownames(mobility_matrices$M)[1])
for (row in 1:nrow(fl_flows)){
o_tract <- fl_flows[row,]$Otract
d_tract <- fl_flows[row,]$Dtract
flow <- fl_flows[row,]$EST
# we use fids to index the matrix
o_fid <- fl_tessellation[Id == o_tract,]$fid
d_fid <- fl_tessellation[Id == d_tract,]$fid
M[as.numeric(o_fid), as.numeric(d_fid)] = flow
}
# D: distance matrix
D <- matrix(NA, nrow = num_tracts, ncol = num_tracts)  # same size as M
dimnames(D) <- list(origin = fid, destination = fid)
for (row in 1:num_tracts){
o_tract <- fl_tessellation[fid == as.character(row),]$Id
cance
for (row in 1:num_tracts){
for (col in 1:num_tracts){
o_tract <- fl_tessellation[fid == as.character(row),]$Id
d_tract <- fl_tessellation[fid == as.character(col),]$Id
# calculate distance between centroids
lon_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLON
lat_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLAT
lon_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLON
lat_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLAT
distance <- crossdist(lon_o_tract, lat_o_tract, lon_d_tract, lat_d_tract)
D[row, col] = distance
}
}
for (row in 1:num_tracts){
for (col in 1:num_tracts){
o_tract <- fl_tessellation[fid == as.character(row),]$Id
d_tract <- fl_tessellation[fid == as.character(col),]$Id
# calculate distance between centroids
lon_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLON
lat_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLAT
lon_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLON
lat_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLAT
distance <- crossdist(lon_o_tract, lat_o_tract, lon_d_tract, lat_d_tract)
if (len(distance) == 0){
distance <- 0
}
D[row, col] = distance
}
}
for (row in 1:num_tracts){
for (col in 1:num_tracts){
o_tract <- fl_tessellation[fid == as.character(row),]$Id
d_tract <- fl_tessellation[fid == as.character(col),]$Id
# calculate distance between centroids
lon_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLON
lat_o_tract <- fl_tessellation[fid == as.character(row),]$INTPTLAT
lon_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLON
lat_d_tract <- fl_tessellation[fid == as.character(col),]$INTPTLAT
distance <- crossdist(lon_o_tract, lat_o_tract, lon_d_tract, lat_d_tract)
if (length(distance) == 0){
distance <- 0
}
D[row, col] = distance
}
